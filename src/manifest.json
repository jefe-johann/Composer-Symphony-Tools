{
  "manifest_version": 3,
  "name": "J's Symphony Tools Extension",
  "description": "Utility extension that makes working with Composer Symphonies easier",
  "version": "3.2.1",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.composer.trade/*"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "Composer Symphony Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.composer.trade/*"
      ],
      "js": [
        "extension-api.js",
        "bridge.js",
        "injector.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "common.js",
        "symphony.js"
      ],
      "matches": [
        "https://app.composer.trade/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://app.composer.trade/*"
    ]
  }
}
